# Sanitized local contract. Copy to backend/.env and replace every CHANGE_ME.
# Never commit the resulting .env file.
DATABASE_URL=mysql+pymysql://feedgo_app:CHANGE_ME@localhost/mitienda_local
RUNTIME_ENVIRONMENT=local

SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=feedgo
JWT_AUDIENCE=feedgo-web
JWT_CONTRACT_VERSION=1

EMBEDDINGS_PROVIDER=simulated
EMBEDDINGS_LOCAL_MODEL_PATH=all-MiniLM-L6-v2

GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_SECONDS=5
GEOAPIFY_RATE_LIMIT_RPS=5

ADMIN_EMAIL_ENABLED=false
ADMINISTRATIVE_OPERATIONAL_EMAIL=
EMAIL_FROM_ADDRESS=
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
ADMIN_BASE_URL=
OPERATIONAL_EMAIL_DISPATCHER_ENABLED=false

IDENTITY_EMAIL_ENABLED=false
IDENTITY_EMAIL_PROVIDER=disabled
IDENTITY_RESEND_API_KEY=
IDENTITY_EMAIL_FROM_ADDRESS=
IDENTITY_EMAIL_PUBLIC_BASE_URL=
IDENTITY_FAKE_MAILBOX_ENABLED=false
PHONE_OTP_FAKE_MAILBOX_ENABLED=false
IDENTITY_SMS_ENABLED=false
IDENTITY_SMS_PROVIDER=disabled
IDENTITY_WHATSAPP_ENABLED=false
IDENTITY_WHATSAPP_PROVIDER=disabled

COMMERCIAL_CAPABILITIES_ENFORCEMENT_ENABLED=false
ACCOUNT_ACTION_RATE_LIMIT_HMAC_SECRET=
PHONE_VERIFICATION_HMAC_SECRET=

GOOGLE_IDENTITY_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=
GOOGLE_OIDC_PUBLIC_BASE_URL=
